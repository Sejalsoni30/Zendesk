# API Base URL (proxied by Vite in dev mode or direct in prod)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Client Configuration (Targets Emulator when VITE_USE_FIREBASE_EMULATOR=true)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-zendesk-automation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-zendesk-automation
VITE_FIREBASE_STORAGE_BUCKET=demo-zendesk-automation.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=true

