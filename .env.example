# ==============================================================================
# MASTER ENVIRONMENT CONFIGURATION (.env.example)
# Zendesk–Darwinbox–Box Automation System
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, private keys, or passwords to version control.
# - This file contains PLACEHOLDERS and default local emulator values.
# - Copy this file to backend/.env and frontend/.env respectively.
# ==============================================================================

# --- Node & Runtime Environment ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Mock vs. Real Integration Toggle ---
# Set to 'true' to use in-memory mock services (no real credentials needed)
# Set to 'false' to connect to live Zendesk, Darwinbox, and Box APIs
USE_MOCK_SERVICES=true
SIMULATE_LATENCY_MS=100

# --- Firebase Admin & Emulator Configuration ---
FIREBASE_PROJECT_ID=demo-zendesk-automation
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Production credentials (leave blank when FIRESTORE_EMULATOR_HOST is set):
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Zendesk Integration ---
ZENDESK_SUBDOMAIN=demo-company
ZENDESK_ADMIN_EMAIL=it-support@example.com
ZENDESK_API_TOKEN=mock_zendesk_token_xyz123
ZENDESK_WEBHOOK_SECRET=demo_webhook_signing_secret_key_883399
ZENDESK_WRITEBACK_ENABLED=true

# --- Darwinbox Integration (HRMS) ---
DARWINBOX_BASE_URL=https://api.darwinbox.example.com
DARWINBOX_CLIENT_ID=mock_db_client_id_001
DARWINBOX_CLIENT_SECRET=mock_db_client_secret_secret
DARWINBOX_API_KEY=mock_db_api_key_456

# --- Box Integration (Case Folders) ---
BOX_CLIENT_ID=mock_box_client_id_789
BOX_CLIENT_SECRET=mock_box_client_secret_999
BOX_ENTERPRISE_ID=mock_box_enterprise_111
BOX_PARENT_FOLDER_ID=0

# --- Workflow & Concurrency Configuration ---
LEASE_DURATION_SECONDS=60
MAX_WORKFLOW_RETRIES=3

# --- Frontend Public Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-zendesk-automation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-zendesk-automation
VITE_FIREBASE_STORAGE_BUCKET=demo-zendesk-automation.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_USE_FIREBASE_EMULATOR=true

