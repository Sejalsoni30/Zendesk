# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Integration Mode Toggle (true = mock without real API keys; false = live REST APIs)
USE_MOCK_SERVICES=true
SIMULATE_LATENCY_MS=100

# Firebase Configuration
FIREBASE_PROJECT_ID=demo-zendesk-automation
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Zendesk Configuration
ZENDESK_SUBDOMAIN=demo-company
ZENDESK_ADMIN_EMAIL=it-support@example.com
ZENDESK_API_TOKEN=mock_zendesk_token_xyz123
ZENDESK_WEBHOOK_SECRET=demo_webhook_signing_secret_key_883399
ZENDESK_WRITEBACK_ENABLED=true

# Darwinbox Configuration
DARWINBOX_BASE_URL=https://api.darwinbox.example.com
DARWINBOX_CLIENT_ID=mock_db_client_id_001
DARWINBOX_CLIENT_SECRET=mock_db_client_secret_secret
DARWINBOX_API_KEY=mock_db_api_key_456

# Box Configuration
BOX_CLIENT_ID=mock_box_client_id_789
BOX_CLIENT_SECRET=mock_box_client_secret_999
BOX_ENTERPRISE_ID=mock_box_enterprise_111
BOX_PARENT_FOLDER_ID=0

# Concurrency & Lease Settings
LEASE_DURATION_SECONDS=60
MAX_WORKFLOW_RETRIES=3

